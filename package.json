{
  "name": "sanchara",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b",
    "check-data": "node scripts/check-data.mjs",
    "narrate": "node --env-file-if-exists=.env.local scripts/narrate.mjs",
    "verify": "npm run check-data && npm test && npm run build",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "shots": "node scripts/phone-shots.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@fontsource-variable/anek-devanagari": "^5.3.0",
    "@fontsource-variable/anek-kannada": "^5.3.0",
    "@fontsource-variable/anek-latin": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1",
    "@google/genai": "^2.23.0",
    "@breezystack/lamejs": "^1.2.7",
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
